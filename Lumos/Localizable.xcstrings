    "settings_capture_shortcuts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture native brightness keys (F5 & F6 / Media Keys)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar teclas nativas de brilho (F5 e F6 / Teclas de Mídia)"
          }
        }
      }
    },
    "settings_show_osd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show native on-screen display (Apple OSD Bezel)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibir indicador visual nativo na tela (OSD Bezel da Apple)"
          }
        }
      }
    },
    "shortcuts_desc_step": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• F5 / F6 or Media Keys: decreases or increases brightness in 1-block steps (1/16)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• F5 / F6 ou Teclas de Mídia: diminui ou aumenta o brilho em passos de 1 bloco (1/16)."
          }
        }
      }
    },
    "shortcuts_desc_fine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Option + Shift + F5 / F6: fine-tuning in 1/4-block steps (1/64)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• Option + Shift + F5 / F6: ajuste fino de 1/4 de bloco (1/64)."
          }
        }
      }
    },
    "shortcuts_desc_universal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Control + Option + Down / Up Arrow: alternative universal shortcut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• Control + Option + Seta Baixo / Cima: atalho universal alternativo."
          }
        }
      }
    },
    "shortcuts_permission_button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Access in System Settings > Privacy & Security > Accessibility"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir Acesso em Ajustes do Sistema > Privacidade & Segurança > Acessibilidade"
