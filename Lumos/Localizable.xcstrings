    "settings_sleep_clamshell_notouchbar" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off on system sleep, lid close, or display sleep"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar ao entrar em repouso, fechar a tampa ou desligar tela"
          }
        }
      }
    },
    "settings_sleep_clamshell_notouchbar_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically turns off keyboard backlight when the MacBook sleeps, screen turns off, or lid is closed, restoring brightness on wake."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliga automaticamente a iluminação do teclado quando o MacBook entrar em repouso, quando a tela apagar ou ao baixar a tampa do Mac, restaurando o brilho ao retornar."
          }
        }
      }
    },
    "settings_sleep_clamshell_touchbar" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off when closing lid or screen turns off"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar ao fechar a tampa ou quando a tela apagar"
          }
        }
      }
    },
    "settings_touchbar_controlstrip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show permanent shortcut in Control Strip"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibir atalho permanente no Control Strip"
          }
        }
      }
    },
    "settings_touchbar_controlstrip_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows tapping the keyboard icon on the right side of the Touch Bar over any app to control illumination."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite tocar no ícone de teclado no canto direito da Touch Bar sobre qualquer aplicativo para controlar a iluminação."
          }
        }
      }
    },
    "settings_touchbar_dim_level" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmed brightness level:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilho ao diminuir (dimming):"
          }
        }
      }
    },
    "settings_touchbar_sync" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync illumination with Touch Bar cycle"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar iluminação com o ciclo da Touch Bar"
          }
        }
      }
    },
    "settings_touchbar_sync_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dims keyboard when Touch Bar dims (~60s), turns off when Touch Bar turns off (~75s), and wakes up instantly when touching keyboard, trackpad, or Touch Bar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminui o teclado quando a Touch Bar esmaecer (~60s), apaga quando a Touch Bar desligar (~75s) e religa instantaneamente ao tocar no teclado, trackpad ou Touch Bar."
          }
        }
      }
    },
    "shortcuts_desc_fine" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Option + Shift + F5 / F6: fine-tuning in 1/4-block steps (1/64)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Option + Shift + F5 / F6: ajuste fino de 1/4 de bloco (1/64)."
          }
        }
      }
    },
    "shortcuts_desc_step" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• F5 / F6 or Media Keys: decreases or increases brightness in 1-block steps (1/16)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• F5 / F6 ou Teclas de Mídia: diminui ou aumenta o brilho em passos de 1 bloco (1/16)."
          }
        }
      }
    },
    "shortcuts_desc_universal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Control + Option + Down / Up Arrow: alternative universal shortcut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Control + Option + Seta Baixo / Cima: atalho universal alternativo."
          }
        }
      }
    },
